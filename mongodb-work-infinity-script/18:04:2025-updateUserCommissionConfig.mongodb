const updateUserCommissionConfig = async () => {
    try {
        const data = fs.readFileSync(
            "/Users/trungdx/Code/mongodb-scripts/json/work-infinity-x/commission/18-04-2025/employee_job_role_mapping.json",
            () => {}
        );
        const rawData = JSON.parse(data);
        rawData.map((item) => {
            console.log("🚀 >>>>>> rawData.map >>>>>> item:", item);
            const employeeId = item?.[`Employee ID`];
            const commissionJobRole = item?.[`Job Role`];
            const commissionStore = item?.[`Work at Store (NAV Code)`];

            console.log("🚀 >>>>>> rawData.map >>>>>> employeeId:", employeeId);

            if (employeeId && commissionJobRole) {
                db.users.findOneAndUpdate(
                    { employeeId },
                    {
                        $set: {
                            commissionConfig: {
                                status: "ENABLE",
                                commissionStore,
                                commissionJobRole,
                            },
                        },
                    }
                );
            }
        });
    } catch (error) {
        console.log("🚀 >>>>>> updateUserCommissionConfig >>>>>> error:", error);
    }
};

updateUserCommissionConfig();
