const fs = require("fs");
// Select the database to use.
use("work_infinity_x_prod");

const CommissionAssignmentStatus = {
    ENABLE: "ENABLE",
    DISABLE: "DISABLE",
};

// The drop() command destroys all data from a collection.
// Make sure you run it against the correct database and collection.

// Build an aggregation to view total sales for each product in 2014.
const updateUserCommissionAssignment = async () => {
    try {
        const data = fs.readFileSync(
            "/Users/admin/Code/mongodb/json/work-infinity-x/commission/12-06-2025/employee_job_role_mapping.json",
            () => {}
        );
        const rawData = JSON.parse(data);
        const month = "2025-06";
        if (rawData?.length) {
            await db.commission_assignment.deleteMany({ month });
            for (const item of rawData) {
                console.log("🚀 >>>>>> rawData.map >>>>>> item:", item);
                const employeeId = item?.[`Employee ID`];
                const commissionJobRoleCode = item?.[`Job Role Code`];
                const storeNavCode = item?.[`Work at Store (NAV Code)`] ?? null;

                console.log(
                    "🚀 >>>>>> rawData.map >>>>>> employeeId:",
                    employeeId
                );

                if (employeeId && commissionJobRoleCode) {
                    const foundUser = await db.users.findOne({ employeeId });
                    let foundStore = null;
                    if (storeNavCode) {
                        foundStore = await db.commission_store.findOne({
                            navCode: storeNavCode,
                        });
                        console.log(
                            "🚀 >>>>>> updateUserCommissionAssignment >>>>>> foundStore:",
                            foundStore
                        );
                    }

                    console.log(
                        "🚀 >>>>>> updateUserCommissionAssignment >>>>>> foundUser:",
                        foundUser
                    );

                    if (foundUser) {
                        const { _id, personalInformation } = foundUser;
                        const {
                            firstNameTh,
                            lastNameTh,
                            firstNameEng,
                            lastNameEng,
                            nickname,
                        } = personalInformation || {};
                        await db.commission_assignment.insertOne({
                            status: CommissionAssignmentStatus.ENABLE,
                            empObjId: _id,
                            employeeId,
                            employeeInformation: {
                                firstNameTh,
                                lastNameTh,
                                firstNameEng,
                                lastNameEng,
                                nickname,
                            },
                            commissionConfig: {
                                commissionStoreCode: foundStore?.code,
                                commissionJobRoleCode,
                            },
                            month,
                            created: new Date(),
                            updated: new Date(),
                        });
                    }
                }
            }
        }
    } catch (error) {
        console.log(
            "🚀 >>>>>> updateUserCommissionAssignment >>>>>> error:",
            error
        );
    }
};

updateUserCommissionAssignment();
