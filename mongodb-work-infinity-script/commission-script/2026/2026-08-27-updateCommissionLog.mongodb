const fs = require("fs");
const moment = require("moment");
const lodash = require("lodash");
const mongoose = require("mongoose");

// Select the database to use.
use("work_infinity_x_dev");

const CommissionAssignmentStatus = {
    ENABLE: "ENABLE",
    DISABLE: "DISABLE",
};

const CommissionLogDailyStatus = {
    ENABLE: "ENABLE",
    DISABLE: "DISABLE",
};

const CommissionLogDailyType = {
    AUTO: "AUTO",
    MANUAL: "MANUAL",
};

const CommissionJobRoleType = {
    MANAGER: "MANAGER",
    EMPLOYEE: "EMPLOYEE",
};

const UPDATE_MODE = {
    REPLACE_ALL: "REPLACE_ALL",
    ADD_NEW: "ADD_NEW",
};

function convertYearMonthToDate(yearMonth) {
    if (!/^\d{4}-\d{2}$/.test(yearMonth)) {
        throw new Error("Invalid format. Expected YYYY-MM");
    }
    const [year, month] = yearMonth.split("-").map(Number);
    const startTime = new Date(year, month - 1, 1);
    const endTime = moment(startTime).endOf("M").toDate();
    return [startTime, endTime];
}

const FULL_DAY_HOURS_THRESHOLD = 8;
const HALF_DAY_HOURS_THRESHOLD = 3;
const LUNCH_BREAK_HOURS = 0.75;
function getStoreHoursWork(startTime, endTime) {
    if (!startTime || !endTime) {
        return 0;
    }
    const hoursWork =
        moment(endTime).diff(moment(startTime), "minutes") / 60 -
        LUNCH_BREAK_HOURS;
    return hoursWork > 0 ? hoursWork : 0;
}

const COMMISSION_MONTH_FORMAT = "YYYY-MM";
const MONTH_TO_GET_COMMISSION_ASSIGNMENT = "2026-07";
const MONTH_TO_ADD_COMMISSION_LOG = "2026-07";

// The drop() command destroys all data from a collection.
// Make sure you run it against the correct database and collection.

const branchCache = {};
const userCache = {};

const branchReplacement = {
    "68db429ad9e06921eade2649": "5da68fba333439165b00012b",
    "68dc9fb99825a93ad661c828": "5d91b958333439165b0000e7",
};
const updateMode = UPDATE_MODE.REPLACE_ALL;

const updateCommissionLog = async () => {
    let updateCounter = 0;
    let commissionAssignmentCounter = 0;
    let checktimeDataCounter = 0;
    let employeeCounter = 0;

    try {
        if (updateMode === UPDATE_MODE.REPLACE_ALL) {
            await db.commission_log_daily.deleteMany({
                month: MONTH_TO_ADD_COMMISSION_LOG,
            });
        }

        let excludeEmployeeIds = [];

        if (updateMode === UPDATE_MODE.ADD_NEW) {
            excludeEmployeeIds = await db.commission_log_daily
                .aggregate([
                    {
                        $match: {
                            month: MONTH_TO_ADD_COMMISSION_LOG,
                            status: CommissionLogDailyStatus.ENABLE,
                        },
                    },
                    {
                        $group: {
                            _id: "$empObjId",
                        },
                    },
                ])
                .toArray();
        }

        const ninEmployeeIds = lodash.map(excludeEmployeeIds, (doc) => {
            return doc._id;
        });

        const [startTime, endTime] = convertYearMonthToDate(
            MONTH_TO_ADD_COMMISSION_LOG
        );
        const commissionAssignList = ninEmployeeIds?.length
            ? await db.commission_assignment
                  .find({
                      month: MONTH_TO_GET_COMMISSION_ASSIGNMENT,
                      status: CommissionAssignmentStatus.ENABLE,
                      jobRoleType: CommissionJobRoleType.EMPLOYEE,
                      empObjId: { $nin: ninEmployeeIds },
                  })
                  .toArray()
            : await db.commission_assignment
                  .find({
                      month: MONTH_TO_GET_COMMISSION_ASSIGNMENT,
                      status: CommissionAssignmentStatus.ENABLE,
                      jobRoleType: CommissionJobRoleType.EMPLOYEE,
                  })
                  .toArray();

        const UnableToDetermineCommissionData = [];

        if (commissionAssignList?.length) {
            const commissionAssignGroups = lodash.groupBy(
                commissionAssignList,
                (doc) => {
                    return doc.empObjId;
                }
            );
            const keys = Object.keys(commissionAssignGroups);

            for (key of keys) {
                const empCommissionAssignments = commissionAssignGroups[key];
                const { employeeId } = empCommissionAssignments?.[0] || {};
                const empObjId = key;
                commissionAssignmentCounter +=
                    empCommissionAssignments?.length || 0;
                employeeCounter++;
                console.log(
                    "🚀 >>>>>> updateCommissionLog >>>>>> employeeCounter:",
                    employeeCounter
                );
                console.log(
                    "🚀 >>>>>> updateCommissionLog >>>>>> commissionAssignmentCounter:",
                    commissionAssignmentCounter
                );

                const checktimeData = await db.check_time
                    .find({
                        createdBy: new mongoose.Types.ObjectId(empObjId),
                        "status.status": { $in: ["APPROVED", "PENDING"] },
                        created: {
                            $gte: startTime,
                            $lte: endTime,
                        },
                    })
                    .toArray();
                if (checktimeData?.length) {
                    for (const checktime of checktimeData) {
                        checktimeDataCounter++;
                        const {
                            timeLine,
                            date,
                            timestamp,
                            status,
                            _id: checktimeId,
                        } = checktime || {};
                        const hasBranchRecord = timeLine?.[0]?.branchId;

                        let branchId = undefined;
                        if (!!hasBranchRecord) {
                            branchId = timeLine?.[0]?.branchId;
                        } else {
                            if (empCommissionAssignments?.length === 1) {
                                let user = userCache[employeeId];
                                if (!user) {
                                    user = await db.users.findOne({
                                        employeeId,
                                    });
                                    userCache[employeeId] = user;
                                }
                                if (user?.roleLevel?.workPlace?.length === 1) {
                                    branchId = user?.roleLevel?.workPlace[0];
                                } else {
                                    UnableToDetermineCommissionData.push({
                                        employeeId,
                                        date,
                                        checktimeId,
                                        messages:
                                            "Multiple workplaces for check-time Event Request !",
                                    });
                                }
                            } else {
                                let user = userCache[employeeId];
                                if (!user) {
                                    user = await db.users.findOne({
                                        employeeId,
                                    });
                                    userCache[employeeId] = user;
                                }
                                if (user?.roleLevel?.workPlace?.length === 1) {
                                    branchId = user?.roleLevel?.workPlace[0];
                                } else {
                                    UnableToDetermineCommissionData.push({
                                        employeeId,
                                        date,
                                        checktimeId,
                                        messages:
                                            "Multiple commission assignments & workplaces !",
                                    });
                                }
                            }
                        }

                        if (branchId) {
                            let branch = branchCache[branchId];
                            if (!branch) {
                                branch = await db.branches.findOne({
                                    _id: new mongoose.Types.ObjectId(branchId),
                                });
                                branchCache[branchId] = branch;
                            }

                            let commissionStoreCodes =
                                branch?.commissionStoreCodes;

                            if (!!branch && !commissionStoreCodes?.length) {
                                if (branchReplacement[branchId]) {
                                    branchId = branchReplacement[branchId];
                                    branch = branchCache[branchId];
                                    if (!branch) {
                                        branch = await db.branches.findOne({
                                            _id: new mongoose.Types.ObjectId(
                                                branchId
                                            ),
                                        });
                                        branchCache[branchId] = branch;
                                    }
                                    commissionStoreCodes =
                                        branch?.commissionStoreCodes;
                                }
                            }

                            if (branch && !!commissionStoreCodes?.length) {
                                for (const storeCode of commissionStoreCodes) {
                                    const sortedTimeLine = lodash.orderBy(
                                        timeLine,
                                        ["date"],
                                        ["asc"]
                                    );
                                    const startTime = sortedTimeLine?.[0]?.date;
                                    const endTime =
                                        sortedTimeLine?.[
                                            sortedTimeLine?.length - 1
                                        ]?.date;
                                    const totalHoursWork = getStoreHoursWork(
                                        startTime,
                                        endTime
                                    );
                                    ``;
                                    const totalWorkingDays =
                                        totalHoursWork >=
                                        FULL_DAY_HOURS_THRESHOLD
                                            ? 1
                                            : totalHoursWork >=
                                              HALF_DAY_HOURS_THRESHOLD
                                            ? 0.5
                                            : 0;
                                    const commissionLogInput = {
                                        status: CommissionLogDailyStatus.ENABLE,
                                        type: CommissionLogDailyType.AUTO,
                                        empObjId: new mongoose.Types.ObjectId(
                                            empObjId
                                        ),
                                        employeeId,
                                        commissionStore: storeCode,
                                        month: MONTH_TO_ADD_COMMISSION_LOG,
                                        date,
                                        timestamp: parseFloat(timestamp),
                                        checktimeData: {
                                            id: new mongoose.Types.ObjectId(
                                                checktimeId
                                            ),
                                            status: status?.status,
                                            branchId,
                                            startTime,
                                            endTime,
                                        },
                                        totalWorkingDays,
                                        totalHoursWork,
                                        created: new Date(),
                                        updated: new Date(),
                                    };

                                    console.log(
                                        "🚀 >>>>>> updateCommissionLog >>>>>> commissionLogInput:",
                                        commissionLogInput
                                    );
                                    await db.commission_log_daily.findOneAndUpdate(
                                        {
                                            empObjId:
                                                new mongoose.Types.ObjectId(
                                                    empObjId
                                                ),
                                            date,
                                            commissionStore: storeCode,
                                        },
                                        {
                                            $set: {
                                                ...commissionLogInput,
                                            },
                                        },
                                        {
                                            upsert: true,
                                        }
                                    );
                                    updateCounter++;
                                    console.log(
                                        "🚀 >>>>>> updateCommissionLog >>>>>> updateCounter:",
                                        updateCounter
                                    );
                                }
                            } else {
                                UnableToDetermineCommissionData.push({
                                    employeeId,
                                    date,
                                    checktimeId,
                                    branchId,
                                    messages:
                                        "No commissionStoreCodes for branch !",
                                });
                            }
                        }
                    }
                } else {
                    UnableToDetermineCommissionData.push({
                        employeeId,
                        messages: "No $checktimeData !",
                    });
                }
            }
        }

        if (UnableToDetermineCommissionData?.length) {
            console.log(
                "🚀 >>>>>> updateCommissionLog >>>>>> UnableToDetermineCommissionData:",
                UnableToDetermineCommissionData
            );

            const groupedData = lodash.groupBy(
                UnableToDetermineCommissionData,
                (doc) => {
                    return doc.employeeId;
                }
            );

            const staticData = Object.keys(groupedData).map((employeeId) => {
                const employeeData = groupedData[employeeId];
                const checktimeIds = employeeData.map(
                    (data) => data.checktimeId
                );
                return {
                    employeeId,
                    numberOfChecktimes: checktimeIds.length,
                    checktimeIds,
                };
            });
            fs.writeFileSync(
                `./UnableToDetermineCommissionData_${MONTH_TO_ADD_COMMISSION_LOG}_${new Date().getTime()}.json`,
                JSON.stringify(UnableToDetermineCommissionData, null, 2)
            );
            fs.writeFileSync(
                `./UnableToDetermineCommissionData_Static__${MONTH_TO_ADD_COMMISSION_LOG}_${new Date().getTime()}.json`,
                JSON.stringify(staticData, null, 2)
            );
        }
        console.log(
            "🚀 >>>>>> updateCommissionLog >>>>>> total commissionAssignment:",
            commissionAssignmentCounter
        );
        console.log(
            "🚀 >>>>>> updateCommissionLog >>>>>> total employees:",
            employeeCounter
        );
        console.log(
            "🚀 >>>>>> updateCommissionLog >>>>>> total checktimeData:",
            checktimeDataCounter
        );
        console.log(
            "🚀 >>>>>> updateCommissionLog >>>>>> total updates:",
            updateCounter
        );
        return false;
    } catch (error) {
        console.log("🚀 >>>>>> updateCommissionLog >>>>>> error:", error);
    }
};

updateCommissionLog();
