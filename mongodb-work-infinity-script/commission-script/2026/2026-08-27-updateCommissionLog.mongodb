                const checktimeData = await db.check_time
                    .find({
                        createdBy: new mongoose.Types.ObjectId(empObjId),
                        "status.status": { $in: ["APPROVED"] },
                        created: {
                            $gte: startTime,
                            $lte: endTime,
                        },
                    })
                    .toArray();
                if (checktimeData?.length) {
                    for (const checktime of checktimeData) {
                        checktimeDataCounter++;
                        console.log(
                            "🚀 >>>>>> updateCommissionLog >>>>>> checktimeDataCounter:",
                            checktimeDataCounter
                        );
                        const {
                            timeLine,
                            date,
                            timestamp,
                            status,
                            _id: checktimeId,
                        } = checktime || {};
                        const hasBranchRecord = timeLine?.[0]?.branchId;

                        let branchId = undefined;
                        if (!!hasBranchRecord) {
                            branchId = timeLine?.[0]?.branchId;
                        } else {
                            if (empCommissionAssignments?.length === 1) {
                                let user = userCache[employeeId];
                                if (!user) {
                                    user = await db.users.findOne({
                                        employeeId,
                                    });
                                    userCache[employeeId] = user;
                                }
                                if (user?.roleLevel?.workPlace?.length === 1) {
                                    branchId = user?.roleLevel?.workPlace[0];
                                } else {
                                    UnableToDetermineCommissionData.push({
                                        employeeId,
                                        checktimeId,
                                        messages:
                                            "Multiple workplaces for check-time Event Request !",
                                    });
                                }
                            } else {
                                UnableToDetermineCommissionData.push({
                                    employeeId,
                                    checktimeId,
                                    messages:
                                        "Multiple commission assignments !",
                                });
                            }
                        }

                        if (branchId) {
                            let branch = branchCache[branchId];
                            if (!branch) {
                                branch = await db.branches.findOne({
                                    _id: branchId,
                                });
                                branchCache[branchId] = branch;
                            }

                            const commissionStoreCodes =
                                branch?.commissionStoreCodes;

                            if (branch && !!commissionStoreCodes?.length) {
                                for (const storeCode of commissionStoreCodes) {
                                    const totalHoursWork = getStoreHoursWork(
                                        timeLine?.[0]?.date,
                                        timeLine?.[timeLine?.length - 1]?.date
                                    );
                                    ``;
                                    const totalWorkingDays =
                                        totalHoursWork >= 8
                                            ? 1
                                            : totalHoursWork >= 4
                                            ? 0.5
                                            : 0;
                                    const commissionLogInput = {
                                        status: CommissionLogDailyStatus.ENABLE,
                                        type: CommissionLogDailyType.AUTO,
                                        empObjId: new mongoose.Types.ObjectId(
                                            empObjId
                                        ),
                                        employeeId,
                                        commissionStore: storeCode,
                                        month: MONTH_TO_ADD_COMMISSION_LOG,
                                        date,
                                        timestamp: parseFloat(timestamp),
                                        checktimeData: {
                                            id: new mongoose.Types.ObjectId(
                                                checktimeId
                                            ),
                                            status: status?.status,
                                            branchId,
                                        },
                                        totalWorkingDays,
                                        totalHoursWork,
                                        created: new Date(),
                                        updated: new Date(),
                                    };

                                    console.log(
                                        "🚀 >>>>>> updateCommissionLog >>>>>> commissionLogInput:",
                                        commissionLogInput
                                    );
                                    await db.commission_log_daily.findOneAndUpdate(
                                        {
                                            empObjId:
                                                new mongoose.Types.ObjectId(
                                                    empObjId
                                                ),
                                            date,
                                            commissionStore: storeCode,
                                        },
                                        {
                                            $set: {
                                                ...commissionLogInput,
                                            },
                                        },
                                        {
                                            upsert: true,
                                        }
                                    );
                                    updateCounter++;
                                    console.log(
                                        "🚀 >>>>>> updateCommissionLog >>>>>> updateCounter:",
                                        updateCounter
                                    );
                                }
                            }
                        }
                    }
                }
            }
        }

        if (UnableToDetermineCommissionData?.length) {
            console.log(
                "🚀 >>>>>> updateCommissionLog >>>>>> UnableToDetermineCommissionData:",
