                const empCommissionAssignments = commissionAssignGroups[key];
                const { employeeId } = empCommissionAssignments?.[0] || {};
                const empObjId = key;
                commissionAssignmentCounter +=
                    empCommissionAssignments?.length || 0;
                employeeCounter++;
                console.log(
                    "🚀 >>>>>> updateCommissionLog >>>>>> employeeCounter:",
                    employeeCounter
                );
                console.log(
