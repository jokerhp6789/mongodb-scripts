const fs = require("fs");
const moment = require("moment");
const lodash = require("lodash");
// Select the database to use.
use("work_infinity_x_prod");

const CommissionAssignmentStatus = {
    ENABLE: "ENABLE",
    DISABLE: "DISABLE",
};

const CommissionLogType = {
    ASSIGNMENT: "ASSIGNMENT",
    LOG: "LOG",
};

function convertYearMonthToDate(yearMonth) {
    if (!/^\d{4}-\d{2}$/.test(yearMonth)) {
        throw new Error("Invalid format. Expected YYYY-MM");
    }
    const [year, month] = yearMonth.split("-").map(Number);
    const startTime = new Date(year, month - 1, 1);
    const endTime = moment(startTime).endOf("M").toDate();
    return [startTime, endTime];
}

const COMMISSION_LOG_MONTH_FORMAT = "YYYY-MM";
const MONTH_TO_GET_COMMISSION_ASSIGNMENT = "2026-07";
const MONTH_TO_ADD_COMMISSION_LOG = "2026-07";

// The drop() command destroys all data from a collection.
// Make sure you run it against the correct database and collection.

const branchCache = {};

const updateCommissionLog = async () => {
    try {
        const [startTime, endTime] = convertYearMonthToDate(
            MONTH_TO_ADD_COMMISSION_LOG
        );
        const cursorCommissionAssign = await db.commission_log.find({
            month: MONTH_TO_GET_COMMISSION_ASSIGNMENT,
            status: CommissionAssignmentStatus.ENABLE,
            type: CommissionLogType.ASSIGNMENT,
        });

        await cursorCommissionAssign.forEach(async (doc) => {
            console.log("🚀 >>>>>> await cursor.forEach >>>>>> doc:", doc);
            const { empObjId, employeeId, commissionJobRole } = doc || {};
            const checktimeData = await db.check_time
                .find({
                    createdBy: empObjId,
                    created: {
                        $gte: startTime,
                        $lte: endTime,
                    },
                })
                .toArray();

            if (checktimeData?.length) {
                const commissionStoreObj = {};
                for (const checktime of checktimeData) {
                    const { totalHoursWork, timeLine } = checktime || {};
                    const branchId = timeLine?.[0]?.branchId;
                    if (branchId) {
                        let branch = branchCache[branchId];
                        if (!branch) {
                            branch = await db.branches.findOne({
                                _id: branchId,
                            });
                            branchCache[branchId] = branch;
                        }

                        if (branch && !!branch?.commissionStoreCodes?.length) {
                            const workingTimeInDays =
                                totalHoursWork >= 8
                                    ? 1
                                    : totalHoursWork >= 4
                                    ? 0.5
                                    : 0;
                            branch?.commissionStoreCodes?.forEach(
                                (storeCode) => {
                                    commissionStoreObj[storeCode] =
                                        commissionStoreObj[storeCode] ?? 0;
                                    commissionStoreObj[storeCode] +=
                                        workingTimeInDays;
                                }
                            );
                        }
                    }
                }
                if (!lodash.isEmpty(commissionStoreObj)) {
                    const commissionStoreObjKeys =
                        Object.keys(commissionStoreObj);
                    for (const storeCode of commissionStoreObjKeys) {
                        const totalWorkingDays = commissionStoreObj[storeCode];

                        await db.commission_log.findOneAndUpdate(
                            {
                                month: MONTH_TO_ADD_COMMISSION_LOG,
                                type: CommissionLogType.LOG,
                                month,
                                commissionJobRole,
                                commissionStore: storeCode,
                                empObjId,
                                employeeId,
                            },
                            {
                                $set: {
                                    empObjId,
                                    employeeId,
                                    employeeInformation,
                                    month,
                                    commissionJobRole,
                                    commissionStore: storeCode,
                                    status: CommissionLogStatus.ENABLE,
                                    type: CommissionLogType.LOG,
                                    managingStores: null,
                                    totalWorkingDays,
                                },
                                $min: { startDate },
                                $max: { endDate },
                                $addToSet: {
                                    checktimeIds: checktimeId,
                                },
                            },
                            {
                                upsert: true,
                            }
                        );
                    }
                }
            }
        });

        return false;
    } catch (error) {
        console.log("🚀 >>>>>> updateCommissionLog >>>>>> error:", error);
    }
};

updateCommissionLog();
