const fs = require("fs");
const moment = require("moment");
// Select the database to use.
use("work_infinity_x_prod");

const OLD_MONtH = "2025-04";
const NEW_MONTH = "2025-05";

const convertYearMonthToDate = (yearMonth) => {
    if (!/^\d{4}-\d{2}$/.test(yearMonth)) {
        throw new Error("Invalid format. Expected YYYY-MM");
    }
    const [year, month] = yearMonth.split("-").map(Number);
    const startTime = new Date(year, month - 1, 1);
    const endTime = moment(startTime).endOf("M").toDate();
    return [startTime, endTime];
};

// The drop() command destroys all data from a collection.
// Make sure you run it against the correct database and collection.

// Build an aggregation to view total sales for each product in 2014.
const duplicateUserCommissionAssignmentFromOldMonth = async () => {
    try {
        const oldMonthData = await db.commission_assignment
            .find({ month: OLD_MONtH })
            .toArray();
        const rawData = oldMonthData;
        if (rawData?.length) {
            const [startTime, endTime] = convertYearMonthToDate(NEW_MONTH);
            await db.commission_assignment.deleteMany({ month: NEW_MONTH });
            const newMonthData = oldMonthData.map((item) => {
                const {
                    _id,
                    startDate,
                    endDate,
                    created,
                    updated,
                    month,
                    ...rest
                } = item || {};

                return {
                    ...rest,
                    month: NEW_MONTH,
                    created: new Date(),
                    updated: new Date(),
                    startDate: null,
                    endDate: null,
                };
            });
            if (newMonthData?.length) {
                await db.commission_assignment.insertMany(newMonthData);
            }
        }
    } catch (error) {
        console.log(
            "🚀 >>>>>> updateUserCommissionAssignment >>>>>> error:",
            error
        );
    }
};

duplicateUserCommissionAssignmentFromOldMonth();
