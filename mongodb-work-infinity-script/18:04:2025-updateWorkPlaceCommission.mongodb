        );
        const rawData = JSON.parse(data);
        rawData.map((item) => {
            console.log("🚀 >>>>>> rawData.map >>>>>> item:", item);
            const branchNo = item?.[`Workplace Code \n(Work Infinity X)`];
            const commissionCode = item?.[`Store Code\n(NAV)`];

            console.log(
                "🚀 >>>>>> rawData.map >>>>>> commissionCode:",
                commissionCode
            );
            console.log("🚀 >>>>>> rawData.map >>>>>> branchNo:", branchNo);

            if (branchNo && commissionCode) {
                db.branches.findOneAndUpdate(
                    { branchNo },
                    { $addToSet: { commissionStoreCodes: commissionCode } }
                );
            }
        });
    } catch (error) {
        console.log("🚀 >>>>>> updateWorkPlaceCommission >>>>>> error:", error);
    }
};

