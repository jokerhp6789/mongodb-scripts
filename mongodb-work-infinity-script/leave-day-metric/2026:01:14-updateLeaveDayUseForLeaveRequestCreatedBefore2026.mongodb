function getTotalDayLeaveFromLeaveRequest(leaveRequest) {
    const { hoursDifferent, leaveTime } = leaveRequest || {};
    if (!hoursDifferent) {
        return leaveTime?.length;
    }
    let totalDay = 0;
    leaveTime.forEach((item) => {
        const startTime = item?.startTime?.$date;
        const endTime = item?.endTime?.$date;
        const diffTime = moment(endTime).diff(moment(startTime), "hours");

        // console.log(
        //     "🚀 >>>>>> getTotalDayLeaveFromLeaveRequest >>>>>> diffTime:",
        //     diffTime
        // );
        if (diffTime > 4) {
            totalDay += 1;
        } else {
            totalDay += 0.5;
        }
    });
    return totalDay;
}

