const fs = require("fs");
const moment = require("moment");
const axios = require("axios");
const _ = require("lodash");
const mongoose = require("mongoose");

// Select the database to use.
use("work_infinity_x_dev");

const splitRemoveSpaceString = (stringData = "") => {
    const breakArray = _.includes(stringData, ";")
        ? _.split(stringData, ";")
        : _.split(stringData, ",");
    return _.map(breakArray, (item) => _.replace(item, "\r", ""));
};

const UPDATING_YEAR = 2025;

function convertCsvJSON(csv) {
    const stringContainCommaList = csv.match(/".*,.*"/g);
    _.forEach(stringContainCommaList, (stringComma) => {
        const convertCommaString = stringComma.replaceAll(", ", "[space]");
        csv = _.replace(csv, stringComma, convertCommaString);
    });
    const lines = _.split(csv, "\n");
    const result = [];
    const headers = splitRemoveSpaceString(lines[0]);

    for (let i = 1; i < lines.length; i++) {
        if (!lines[i]) continue;
        const obj = {};
        const currentLine = splitRemoveSpaceString(lines[i]);

        for (let j = 0; j < headers.length; j++) {
            const currentHeader = headers[j];
            let value = currentLine[j];
            if (value === "TRUE") {
                value = true;
            }
            if (value === "FALSE") {
                value = false;
            }
            if (!_.isEmpty(currentHeader)) {
                const valueRemoveSpace = value.replaceAll("[space]", ", ");
                // eslint-disable-next-line no-useless-escape
                const valueRemoveMark = valueRemoveSpace.replaceAll(`\"`, "");
                obj[currentHeader] = valueRemoveMark
                    ? valueRemoveMark.trim()
                    : "";
            }
        }
        result.push(obj);
    }
    return result;
}

const importEmployeeLeaveDayMetric = async () => {
    try {
        const data = fs.readFileSync(
            "/Users/admin/Code/mongodb/mongodb-work-infinity-script/xls/leave-day-import-new/DH.csv",
