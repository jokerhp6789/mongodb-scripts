                    employeeId
                );

                const list = [];
                Object.keys(rest).forEach((code) => {
                    const value = rest[code];
                    if (value) {
                        const numericValue = Number(value);
                        console.log(
                            "🚀 >>>>>> importEmployeeLeaveDayMetric >>>>>> numericValue:",
                            numericValue
                        );
                        if (!!numericValue) {
                            list.push({ k: code, v: numericValue });
                        }
                    }
                });

                if (list?.length > 0) {
                    const employee = db.users.findOne({
                        employeeId: employeeId,
                    });
                    if (employee) {
                        const config = [];
                        for (const itemList of list) {
                            const { k, v } = itemList;
                            const leaveReason =
                                await db.leaverequestreasons.findOne({
                                    code: k,
                                });

                            console.log(
                                "🚀 >>>>>> importEmployeeLeaveDayMetric >>>>>> leaveReason:",
                                leaveReason
